{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Windows Performance Diagnostics Toolkit Report",
  "description": "Schema for diagnostic-plan.json (Plan mode) and diagnostic-manifest.json (Collect mode) emitted by the Windows Performance Diagnostics Toolkit.",
  "type": "object",
  "required": [
    "schemaVersion",
    "toolName",
    "toolVersion",
    "mode",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "toolName": {
      "type": "string",
      "enum": [
        "Windows Performance Diagnostics Toolkit"
      ]
    },
    "toolVersion": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "Plan",
        "Collect"
      ]
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "outputDirectory": {
      "type": "string"
    },
    "safety": {
      "type": "object",
      "required": [
        "localOnly",
        "readOnly",
        "requiresExplicitCollectionConsent",
        "automaticUpload",
        "automaticRemediation",
        "automaticLogClearing"
      ],
      "properties": {
        "localOnly": {
          "type": "boolean"
        },
        "readOnly": {
          "type": "boolean"
        },
        "requiresExplicitCollectionConsent": {
          "type": "boolean"
        },
        "automaticUpload": {
          "type": "boolean"
        },
        "automaticRemediation": {
          "type": "boolean"
        },
        "automaticLogClearing": {
          "type": "boolean"
        },
        "remoteTarget": {
          "type": "string",
          "description": "Present only in remote mode: the computer the collection runs on."
        },
        "remoteTransport": {
          "type": "string",
          "enum": [
            "winrm"
          ]
        }
      },
      "additionalProperties": false
    },
    "plannedActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wpr": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "GeneralProfile",
            "CPU",
            "DiskIO",
            "FileIO",
            "Network",
            "Power",
            "GPU",
            "Registry"
          ]
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "etlFilePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAtUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completedAtUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "startExitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stopExitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "skipped-wpr-not-found",
            "skipped-elevation-required",
            "failed",
            "running",
            "not-requested",
            "removed-oversized"
          ]
        },
        "requestedDurationSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 600
        },
        "actualDurationSeconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "maxFileMB": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4096
        },
        "concurrentWithSampling": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "etlBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "autoSizedDuration": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "loggingMode": {
          "type": [
            "string",
            "null"
          ]
        },
        "effectiveDurationSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 5,
          "maximum": 600
        },
        "sizeLimitExceeded": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "traceRemovedOversized": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "relatedArtifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "defender": {
      "type": "object",
      "properties": {
        "durationSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 5,
          "maximum": 600
        },
        "etlFilePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAtUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completedAtUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "moduleVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "skipped-defender-module-not-found",
            "skipped-elevation-required",
            "failed"
          ]
        },
        "requestedDurationSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 600
        },
        "autoSizedDuration": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "minidumps": {
      "type": "object",
      "description": "Present when -CollectMinidumps was requested. Plan mode advertises the scope; Collect mode reports the outcome. Source dumps are copied read-only; MEMORY.DMP is metadata only.",
      "properties": {
        "sourcePath": {
          "type": "string"
        },
        "maxTotalBytes": {
          "type": "integer"
        },
        "memoryDumpRecordedNotCopied": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "skipped-no-minidumps"
          ]
        },
        "memoryDump": {
          "type": "object",
          "properties": {
            "exists": {
              "type": "boolean"
            },
            "sizeBytes": {
              "type": [
                "integer",
                "null"
              ]
            },
            "lastWriteTimeUtc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "copiedCount": {
          "type": "integer"
        },
        "skippedCount": {
          "type": "integer"
        },
        "totalBytes": {
          "type": "integer"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Name": {
                "type": "string"
              },
              "SizeBytes": {
                "type": "integer"
              },
              "SourceLastWriteTimeUtc": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "bootFailureLogs": {
      "type": "object",
      "description": "Present when -CollectBootFailureLogs was requested. Plan mode advertises the scope; Collect mode reports per-source outcome. Oversized logs are recorded with skippedReason 'oversized', never truncated.",
      "properties": {
        "maxBytesPerFile": {
          "type": "integer"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed"
          ]
        },
        "copiedCount": {
          "type": "integer"
        },
        "skippedOversizedCount": {
          "type": "integer"
        },
        "sourceEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "sourcePath": {
                "type": "string"
              },
              "found": {
                "type": "boolean"
              },
              "sizeBytes": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "copied": {
                "type": "boolean"
              },
              "copiedTo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "skippedReason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "description": "Present when -ZipOutput was requested. Plan mode advertises the destination and name pattern; Collect mode reports the produced case zip. The zip contains only this run's whitelisted artifacts plus the manifest.",
      "properties": {
        "destination": {
          "type": "string"
        },
        "namePattern": {
          "type": "string"
        },
        "includesManifest": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed"
          ]
        },
        "zipPath": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "remote": {
      "type": "object",
      "description": "Present when -RemoteComputer was requested. Plan mode advertises the target and transport; Collect mode reports the pull-back result. The tool never enables WinRM on the target.",
      "properties": {
        "computerName": {
          "type": "string"
        },
        "transport": {
          "type": "string",
          "enum": [
            "winrm"
          ]
        },
        "winrmStatus": {
          "type": "string",
          "enum": [
            "ok",
            "failed-winrm-unavailable"
          ]
        },
        "remoteOutputDirectory": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed"
          ]
        },
        "pulledFileCount": {
          "type": "integer"
        },
        "verifiedSha256Count": {
          "type": "integer"
        },
        "hashVerificationFailed": {
          "type": "boolean"
        },
        "pulledAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "startedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "completedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "properties": {
        "durationSeconds": {
          "type": "integer"
        },
        "maxSystemEvents": {
          "type": "integer"
        },
        "systemEventLookbackHours": {
          "type": "integer"
        },
        "sampleIntervalSeconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "performanceMode": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "markerMode": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "eventWindowMinutes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "maxTrackedProcesses": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "system": {
      "type": "object",
      "additionalProperties": true
    },
    "systemEventLog": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "recordCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pulledCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "skippedUnrenderableCount": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "crashAnalysis": {
      "type": "object",
      "properties": {
        "bugchecks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "TimeCreated": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "BugcheckCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Message": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "unexplainedShutdowns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "TimeCreated": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "Message": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "description": "In Plan mode: the planned read-only network-state sub-collections. In Collect mode: the DNS-vs-ping split-test summary and security-software match counts from the captured network-state.json.",
      "properties": {
        "subCollections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed"
          ]
        },
        "artifact": {
          "type": "string"
        },
        "dnsVsPing": {
          "type": "object",
          "properties": {
            "rawIpReachable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "dnsResolutionOk": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "verdict": {
              "type": "string",
              "enum": [
                "dns-and-connectivity-ok",
                "dns-failure",
                "icmp-blocked-or-partial",
                "connectivity-failure",
                "inconclusive"
              ]
            }
          },
          "additionalProperties": false
        },
        "securitySoftwareMatches": {
          "type": "object",
          "properties": {
            "processMatches": {
              "type": "integer"
            },
            "installedSoftwareMatches": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "sectionErrorCount": {
          "type": "integer"
        },
        "udpEndpointCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "dynamicUdpPortRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Family": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "StartPort": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "PortCount": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "EndPort": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "udpEndpointCountByProcess": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "OwningProcess": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "ProcessName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "EndpointCount": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "dynamicUdpPortUsage": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "totalUdpEndpoints": {
              "type": [
                "integer",
                "null"
              ]
            },
            "endpointsInsideDynamicRange": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "symptom": {
      "type": "object",
      "description": "Optional user-reported symptom context. Present in both Plan and Collect modes when -SymptomContext is provided. Records the reported symptom separately from the collection window timestamps.",
      "properties": {
        "reported": {
          "type": [
            "string",
            "null"
          ],
          "description": "The user-provided symptom description. Absent when only a preset was supplied."
        },
        "preset": {
          "type": "string",
          "enum": [
            "baseline",
            "cpu-heavy",
            "memory-pressure",
            "storage-io",
            "network-io",
            "boot-slowdown",
            "application-freeze"
          ],
          "description": "Optional collection preset chosen by the user."
        },
        "collectionWindow": {
          "type": "object",
          "description": "Timestamps recording when the symptom was reported and when collection occurred.",
          "properties": {
            "requestedAtUtc": {
              "type": "string",
              "format": "date-time",
              "description": "UTC timestamp when the user reported the symptom."
            },
            "startedAtUtc": {
              "type": "string",
              "format": "date-time",
              "description": "UTC timestamp when collection started (Collect mode only)."
            },
            "completedAtUtc": {
              "type": "string",
              "format": "date-time",
              "description": "UTC timestamp when collection completed (Collect mode only)."
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "collectionWindow"
      ],
      "additionalProperties": false
    },
    "collectionErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Stage",
          "Message"
        ],
        "properties": {
          "Stage": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "diskMetrics": {
      "type": "array",
      "description": "Per-disk I/O summary metrics from Win32_PerfFormattedData_PerfDisk_PhysicalDisk (last sample). Null when CIM classes are unavailable (e.g. non-Windows hosts, restricted tokens). Sustained disk findings use the paired raw-counter series in the disk-samples.json artifact, not this summary.",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "PercentDiskTime": {
            "type": [
              "integer",
              "null"
            ]
          },
          "PercentDiskReadTime": {
            "type": [
              "integer",
              "null"
            ]
          },
          "PercentDiskWriteTime": {
            "type": [
              "integer",
              "null"
            ]
          },
          "DiskReadsPerSec": {
            "type": [
              "integer",
              "null"
            ]
          },
          "DiskWritesPerSec": {
            "type": [
              "integer",
              "null"
            ]
          },
          "DiskBytesPerSec": {
            "type": [
              "integer",
              "null"
            ]
          },
          "DiskReadBytesPerSec": {
            "type": [
              "integer",
              "null"
            ]
          },
          "DiskWriteBytesPerSec": {
            "type": [
              "integer",
              "null"
            ]
          },
          "CurrentDiskQueueLength": {
            "type": [
              "integer",
              "null"
            ]
          },
          "AvgDiskReadQueueLength": {
            "type": [
              "number",
              "null"
            ]
          },
          "AvgDiskWriteQueueLength": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "volumeMetrics": {
      "type": "array",
      "description": "Per-volume free space from Win32_Volume. Null when CIM classes are unavailable.",
      "items": {
        "type": "object",
        "properties": {
          "DriveLetter": {
            "type": [
              "string",
              "null"
            ]
          },
          "Label": {
            "type": [
              "string",
              "null"
            ]
          },
          "FileSystem": {
            "type": [
              "string",
              "null"
            ]
          },
          "CapacityBytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "FreeSpaceBytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "PercentFree": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "memoryMetrics": {
      "type": "object",
      "description": "Memory committed bytes, commit limit, available bytes, and paging indicators from Win32_PerfFormattedData_PerfOS_Memory. Null when CIM classes are unavailable.",
      "properties": {
        "committedBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "commitLimitBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "availableBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pageFaultsPerSec": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Total page faults per second (soft+hard). Not equivalent to hard faults alone."
        },
        "pageReadsPerSec": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Hard page faults: pages read from disk to resolve page faults."
        },
        "pageWritesPerSec": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pagesInputPerSec": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Pages moved from disk to memory (hard fault input)."
        },
        "pagesOutputPerSec": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Name",
          "SizeBytes",
          "Sha256"
        ],
        "properties": {
          "Name": {
            "type": "string"
          },
          "SizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "Sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "performanceMode": {
      "type": "object",
      "description": "Plan-mode advertisement of the concurrent incident-capture stages.",
      "properties": {
        "concurrentCaptureWindow": {
          "type": "boolean"
        },
        "baselineSeconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sampleIntervalSeconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "markerMode": {
          "type": "boolean"
        },
        "markerPreSeconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "markerPostSeconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "maxTrackedProcesses": {
          "type": [
            "integer",
            "null"
          ]
        },
        "eventWindowMinutes": {
          "type": [
            "integer",
