      "rules": [
        {
          "id": "memory-leak-user-growth",
          "category": "memory-leak",
          "title": "Sustained per-process working-set growth",
          "summary": "One process grew monotonically across the measured window.",
          "metric": "WorkingSetGrowthPercent",
          "comparator": "ge",
          "threshold": 20,
          "minimumSamples": 10,
          "minimumDurationSeconds": 10,
          "sourceArtifact": "process-memory-samples.csv",
          "severity": {
            "default": "medium",
            "escalations": [
              {
                "severity": "high",
                "when": "the process identity is stable across the whole window and the growth continues after the workload is idle"
              }
            ]
          },
          "confidence": {
            "default": "Medium",
            "conditions": [
              {
                "level": "High",
                "when": "the same PID and StartTime pair grows monotonically across at least 30 samples with no identity change"
              },
              {
                "level": "Low",
                "when": "the window is shorter than 30 samples or the process identity changes during the window"
              }
            ]
          },
          "correlationRequirements": [
            {
              "metric": "AvailableMemoryMB",
              "comparator": "le",
              "threshold": 2048,
              "kind": "required-any-of",
              "note": "Growth matters when it consumes the machine headroom"
            }
          ],
          "trend": {
            "direction": "increasing",
            "minimumDeltaPercent": 20,
            "minimumSamples": 10,
            "monotonicWindow": 10
          },
          "uncertainty": "Growth alone can be a cache warming up.",
          "nextSteps": [
            "Collect a heap or handle trace for the process."
          ],
          "suggestedWprProfile": "CPU"
        }
      ],
