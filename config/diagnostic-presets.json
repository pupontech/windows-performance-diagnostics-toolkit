{
  "artifact": "diagnostic-presets",
  "schemaVersion": "1.3",
  "description": "Functional diagnostic presets. A preset selects Tier 1 counters, a Tier 2 WPR recording, an expected duration, analysis modules, event channels, escalation options, a trace-size budget and a privacy level. Display text alone is not a preset: the validator (tests/test_rules_presets.py) rejects any record that only changes metadata.",
  "samplingFloorSeconds": 1,
  "samplingFloorBasis": "Microsoft states performance counters are not designed to be collected more than once per second; no preset may go below the floor.",
  "canonicalPresets": [
    "general",
    "cpu-heavy",
    "memory-pressure",
    "memory-leak",
    "storage-io",
    "network",
    "gpu",
    "ui-hang",
    "ui-stutter",
    "boot-slowdown",
    "audio-glitch",
    "power",
    "intermittent"
  ],
  "aliases": {
    "baseline": "general",
    "network-io": "network",
    "application-freeze": "ui-hang"
  },
  "aliasPolicy": "Deprecated names resolve to the canonical preset. The manifest records both the requested and the effective name; the alias map lives here, not in code.",
  "privacyLevels": [
    "Standard",
    "Redacted",
    "Full"
  ],
  "privacyDefault": "Standard",
  "privacyPolicy": "Standard is the default and it is opt-down. Redacted hashes user names and paths and suppresses command lines. Full requires an explicit flag plus a consent prompt. No secret, token, cookie, browser history or document content is collected in any level.",
  "wpr": {
    "discoveryCommand": "wpr -profiles",
    "discoveryPolicy": "A profile name is passed to wpr -start verbatim. Availability MUST be confirmed with wpr -profiles on the target machine; an unavailable profile is reported as unsupported and is never silently substituted.",
    "verifiedProfiles": [
      "GeneralProfile",
      "CPU",
      "DiskIO",
      "NetworkProfile"
    ],
    "detailLevels": [
      "light",
      "verbose"
    ],
    "modes": [
      "memory",
      "file"
    ],
    "defaultMode": "memory",
    "fileModeRequiresOptIn": true,
    "unboundedFileModePolicy": "The default recording mode is memory. File mode records to an unbounded file that can grow until it fills the disk, so it is opt-in, never a default, and always carries a preflight free-space check.",
    "markerMechanism": "wpr -marker",
    "stopForm": "wpr -stop <file> <problem description>",
    "cancelForm": "wpr -cancel",
    "bootMechanism": "wpr -boottrace -addboot <profile> followed by -stopboot <file> <description>, or -cancelboot to remove the autologger",
    "bootPolicy": "A boot trace requires a reboot between -addboot and -stopboot; without that reboot no trace is produced, and the on/off scenario profiles reboot three times by default unless the iteration count is set explicitly."
  },
  "analysisModules": [
    { "id": "counter-trends", "kind": "analysis", "purpose": "Sustained and trend evaluation of the Tier 1 series" },
    { "id": "sustained-window", "kind": "analysis", "purpose": "Longest qualifying run of consecutive samples, including burst-then-recovery" },
    { "id": "coverage-report", "kind": "analysis", "purpose": "Per-collector status, duration, record count and coverage states" },
    { "id": "evidence-index", "kind": "analysis", "purpose": "Evidence provenance records that every conclusion must reference" },
    { "id": "process-ranking", "kind": "analysis", "purpose": "Per-process CPU, commit, pagefile and I/O ranking for the selected window" },
    { "id": "incident-vs-baseline", "kind": "analysis", "purpose": "Compare the incident window against the nearby baseline window" },
    { "id": "memory-taxonomy", "kind": "analysis", "purpose": "Commit versus physical versus pagefile versus hard-fault taxonomy" },
    { "id": "leak-growth-detection", "kind": "analysis", "purpose": "Monotonic growth of a per-process or pool series over the window" },
    { "id": "pool-growth", "kind": "analysis", "purpose": "Kernel pool growth series and pool tag attribution" },
    { "id": "pagefile-analysis", "kind": "analysis", "purpose": "Pagefile usage, hosts and temporary pagefile state" },
    { "id": "disk-latency-percentiles", "kind": "analysis", "purpose": "Paired raw disk counter latency with operation bases and percentiles" },
    { "id": "network-counters", "kind": "analysis", "purpose": "TCP retransmit, connection failure and reset counters, plus adapter statistics" },
    { "id": "gpu-unavailable-aware", "kind": "analysis", "purpose": "GPU engine and process memory values with explicit unsupported states" },
    { "id": "ui-responsiveness", "kind": "analysis", "purpose": "Hang and stutter evidence: hang events, wait chain results, scheduler and ReadyThread evidence" },
    { "id": "boot-phase-breakdown", "kind": "analysis", "purpose": "Power-on to desktop phase descriptors from a boot recording" },
    { "id": "power-state-analysis", "kind": "analysis", "purpose": "Processor frequency and power-state evidence including powercfg reports" },
    { "id": "audio-glitch-analysis", "kind": "analysis", "purpose": "Streaming-audio glitch events correlated with DPC/ISR and CPU evidence" },
    { "id": "event-correlation", "kind": "analysis", "purpose": "Correlate collected events with the window and with counter evidence" },
    { "id": "crash-correlation", "kind": "analysis", "purpose": "Bugchecks, dumps, LiveKernelReports and Kernel-Power 41 correlation" },
    { "id": "servicing-log-analysis", "kind": "analysis", "purpose": "CBS and servicing signature analysis over copied logs" },
    { "id": "wpa-exporter-cpu", "kind": "analysis", "purpose": "WPAExporter CPU tables with the sampled versus precise distinction preserved" },
    { "id": "wpa-exporter-diskio", "kind": "analysis", "purpose": "WPAExporter disk I/O tables for the incident window" },
    { "id": "wpa-exporter-network", "kind": "analysis", "purpose": "WPAExporter network tables for the incident window" },
    { "id": "wpa-exporter-gpu", "kind": "analysis", "purpose": "WPAExporter GPU and composition tables, reported unsupported when absent" },
    { "id": "wpa-exporter-responsiveness", "kind": "analysis", "purpose": "WPAExporter responsiveness and scheduler tables" },
    { "id": "flight-recorder-ring", "kind": "analysis", "purpose": "Circular capture review for intermittent faults" }
  ],
  "eventChannels": [
    { "id": "System", "kind": "log", "note": "Primary system log; WHEA-Logger and Kernel-Power write here" },
    { "id": "Application", "kind": "log", "note": "Application crashes, hangs and service failures" },
    { "id": "Microsoft-Windows-WER/Operational", "kind": "log", "optional": true },
    { "id": "Microsoft-Windows-Kernel-LiveDump/Operational", "kind": "log", "optional": true },
    { "id": "Microsoft-Windows-DriverFrameworks-UserMode/Operational", "kind": "log", "optional": true },
    { "id": "Microsoft-Windows-Kernel-PnP/Configuration", "kind": "log", "optional": true },
    { "id": "WHEA-Logger", "kind": "provider", "log": "System", "note": "Hardware error recurrence; read from the System log by provider" },
    { "id": "Kernel-Power", "kind": "provider", "log": "System", "note": "Unexpected shutdown correlation; read from the System log by provider" },
    { "id": "Application Hang", "kind": "provider", "log": "Application", "note": "User-mode hang evidence; read from the Application log by provider" },
    { "id": "Application Error", "kind": "provider", "log": "Application", "note": "User-mode crash evidence; read from the Application log by provider" }
  ],
  "channelPolicy": "An optional log that is absent on the SKU is skipped silently and reported as not-collected, never as healthy. A provider that never appears in the window is not evidence of absence.",
  "escalationOptions": [
    { "id": "wait-chain-traversal", "tier": 3, "requiresConsent": true, "absentToolBehavior": "report-unsupported", "note": "Does not require an external download; reports waits only for the documented primitives" },
    { "id": "procdump-mini-on-consent", "tier": 3, "requiresConsent": true, "absentToolBehavior": "report-unsupported", "note": "Mini dump (-mm), never a full core dump; note the exact dump type on the escalation record" },
    { "id": "poolmon-tag-attribution", "tier": 3, "requiresConsent": true, "absentToolBehavior": "report-unsupported" },
    { "id": "defender-performance-report", "tier": 3, "requiresConsent": true, "absentToolBehavior": "report-unsupported", "note": "Reads Defender's own recorded scan work; never changes protection state or proposes an exclusion" },
    { "id": "minifilter-enumeration", "tier": 3, "requiresConsent": true, "absentToolBehavior": "report-unsupported", "note": "Filter list and altitudes; no filter is unloaded or altered" },
    { "id": "storage-reliability-counters", "tier": 3, "requiresConsent": true, "absentToolBehavior": "report-unsupported", "note": "Unsupported or not-exposed states are reported explicitly" },
    { "id": "pktmon-packet-capture", "tier": 3, "requiresConsent": true, "absentToolBehavior": "report-unsupported", "note": "Drop reasons first; netsh scenario traces only when pktmon is inconclusive" },
    { "id": "powercfg-energy-report", "tier": 3, "requiresConsent": true, "absentToolBehavior": "report-unsupported", "note": "Report covers a defined observation window and is most meaningful when the machine is idle" },
    { "id": "boot-trace-autologger", "tier": 3, "requiresConsent": true, "requiresReboot": true, "absentToolBehavior": "report-unsupported", "note": "Requires a reboot between -addboot and -stopboot; never scheduled without explicit operator approval" },
    { "id": "wpa-exporter-tables", "tier": 2, "requiresConsent": false, "absentToolBehavior": "report-unsupported", "note": "Exports CSV tables from the captured ETL; a trace with no analysis tables keeps its raw ETL artifact" }
  ],
  "counters": [
    { "id": "cpu.loadPercent", "field": "AverageCpuLoadPercent", "counterPath": "\\Processor Information(_Total)\\% Processor Time", "unit": "percent", "basis": "Existing toolkit sample field; kept as the fallback view" },
    { "id": "cpu.utilityPercent", "counterPath": "\\Processor Information(_Total)\\% Processor Utility", "unit": "percent", "basis": "Documented counter; may exceed 100 percent on boost-capable systems and that is not an error" },
    { "id": "cpu.dpcPercent", "counterPath": "\\Processor Information(_Total)\\% DPC Time", "unit": "percent" },
    { "id": "cpu.interruptPercent", "counterPath": "\\Processor Information(_Total)\\% Interrupt Time", "unit": "percent" },
    { "id": "cpu.interruptsPerSec", "counterPath": "\\Processor Information(_Total)\\Interrupts/sec", "unit": "rate" },
    { "id": "cpu.dpcsQueuedPerSec", "counterPath": "\\Processor Information(_Total)\\DPCs Queued/sec", "unit": "rate" },
    { "id": "cpu.queueLength", "counterPath": "\\System\\Processor Queue Length", "unit": "count" },
    { "id": "cpu.contextSwitchesPerSec", "counterPath": "\\System\\Context Switches/sec", "unit": "rate" },
    { "id": "memory.commitPercent", "counterPath": "\\Memory\\% Committed Bytes In Use", "unit": "percent", "basis": "Commit charge view recommended by the specification" },
    { "id": "memory.availableBytes", "counterPath": "\\Memory\\Available Bytes", "unit": "bytes", "field": "AvailableBytes" },
    { "id": "memory.availableMB", "field": "AvailableMemoryMB", "unit": "megabytes", "basis": "Existing toolkit sample field" },
    { "id": "memory.pagesInputPerSec", "counterPath": "\\Memory\\Pages Input/sec", "field": "PagesInputPerSec", "unit": "rate", "basis": "Pages read to resolve hard faults" },
    { "id": "memory.pagesOutputPerSec", "counterPath": "\\Memory\\Pages Output/sec", "field": "PagesOutputPerSec", "unit": "rate" },
    { "id": "memory.pageFaultsPerSec", "counterPath": "\\Memory\\Page Faults/sec", "field": "PageFaultsPerSec", "unit": "rate", "basis": "Includes soft faults; not a hard-fault paging measure" },
    { "id": "memory.pageReadsPerSec", "counterPath": "\\Memory\\Page Reads/sec", "field": "PageReadsPerSec", "unit": "rate" },
    { "id": "pagefile.usagePercent", "counterPath": "\\Paging File(_Total)\\% Usage", "unit": "percent" },
    { "id": "process.privateBytesPeak", "field": "TopPrivateBytes", "unit": "bytes", "basis": "Per-process commit charge from the continuous process series" },
    { "id": "process.sumPrivateBytes", "field": "SumPrivateBytes", "unit": "bytes" },
    { "id": "process.pageFileBytesPeak", "field": "TopPageFileBytes", "unit": "bytes" },
    { "id": "process.workingSetGrowthPercent", "unit": "percent", "basis": "Derived from the PID plus StartTime per-process series" },
    { "id": "disk.queueLength", "counterPath": "\\PhysicalDisk(_Total)\\Current Disk Queue Length", "field": "CurrentQueueLength", "unit": "count" },
    { "id": "disk.readLatencySeconds", "counterPath": "\\PhysicalDisk(_Total)\\Avg. Disk sec/Read", "field": "ReadLatencySeconds", "unit": "seconds" },
    { "id": "disk.writeLatencySeconds", "counterPath": "\\PhysicalDisk(_Total)\\Avg. Disk sec/Write", "field": "WriteLatencySeconds", "unit": "seconds" },
    { "id": "disk.transferLatencySeconds", "counterPath": "\\PhysicalDisk(_Total)\\Avg. Disk sec/Transfer", "field": "TransferLatencySeconds", "unit": "seconds" },
    { "id": "disk.percentFree", "counterPath": "\\LogicalDisk(_Total)\\% Free Space", "field": "PercentFree", "unit": "percent" },
    { "id": "network.retransmitPerSec", "counterPath": "\\TCPv4\\Segments Retransmitted/sec", "unit": "rate", "basis": "Documented TCPv4/TCPv6 resource counter; a non-zero rate alone does not establish a fault" },
    { "id": "network.connectionFailures", "counterPath": "\\TCPv4\\Connection Failures", "unit": "count" },
    { "id": "network.connectionsReset", "counterPath": "\\TCPv4\\Connections Reset", "unit": "count" },
    { "id": "gpu.engineUtilizationPercent", "counterPath": "\\GPU Engine(*)\\Utilization Percentage", "unit": "percent", "basis": "Existing toolkit GPU engine counter" },
    { "id": "gpu.processDedicatedUsageBytes", "counterPath": "\\GPU Process Memory(*)\\Dedicated Usage", "unit": "bytes", "basis": "Existing toolkit GPU process memory counter" },
    { "id": "power.maxFrequencyPercent", "counterPath": "\\Processor Information(_Total)\\% of Maximum Frequency", "unit": "percent", "basis": "Documented frequency-cap verification counter" },
    { "id": "responsiveness.hangEvents", "field": "ApplicationHangEvents", "unit": "count", "basis": "Event-derived: Application Hang provider in the Application log" },
    { "id": "pool.growthPercent", "field": "PoolGrowthPercent", "unit": "percent", "basis": "Derived from the kernel pool series" }
  ],
  "remediation": {
    "automaticRemediation": false,
    "operatorConfirmationRequired": true,
    "policy": "No preset repairs, restarts, clears, tunes or changes any setting. Findings and next steps are advisory; every collection action that writes to the machine is gated on explicit operator consent."
  },
  "presets": {
    "general": {
      "displayName": "General system slowness",
      "symptomSummary": "Unexplained degradation across components, or a multi-symptom report with no single dominant suspect.",
      "tier1Counters": ["cpu.loadPercent", "cpu.utilityPercent", "cpu.queueLength", "memory.commitPercent", "memory.availableMB", "memory.pagesInputPerSec", "disk.queueLength", "disk.readLatencySeconds", "disk.writeLatencySeconds", "disk.percentFree", "process.sumPrivateBytes"],
      "tier1SampleIntervalSeconds": 1,
      "tier2": { "wprProfiles": ["GeneralProfile"], "wprDetail": "verbose", "wprMode": "memory" },
      "expectedDurationSeconds": 300,
      "analysisModules": ["counter-trends", "sustained-window", "coverage-report", "evidence-index", "process-ranking", "event-correlation", "wpa-exporter-cpu"],
      "eventChannels": ["System", "Application", "WHEA-Logger", "Kernel-Power"],
      "escalationOptions": [],
      "traceSizeBudget": { "budgetMiB": 2048, "mode": "memory", "basis": "Toolkit guard: free-space preflight plus a post-stop ETL size check. WPR memory-mode buffers are not a disk-size bound, so the budget is the toolkit's own ceiling and not a WPR option.", "overBudgetAction": "stop-and-keep-partial-trace-with-explicit-truncation-record" },
      "privacyLevel": "Standard",
      "remediation": { "automaticRemediation": false, "operatorConfirmationRequired": true }
    },
    "cpu-heavy": {
      "displayName": "Sustained CPU pressure",
      "symptomSummary": "The machine is responsive but hot and slow under load; the reporter suspects CPU saturation.",
      "tier1Counters": ["cpu.loadPercent", "cpu.utilityPercent", "cpu.queueLength", "cpu.dpcPercent", "cpu.interruptPercent", "cpu.interruptsPerSec", "cpu.dpcsQueuedPerSec", "cpu.contextSwitchesPerSec", "process.sumPrivateBytes"],
      "tier1SampleIntervalSeconds": 1,
      "tier2": { "wprProfiles": ["CPU", "GeneralProfile"], "wprDetail": "verbose", "wprMode": "memory" },
      "expectedDurationSeconds": 180,
      "analysisModules": ["counter-trends", "sustained-window", "process-ranking", "coverage-report", "wpa-exporter-cpu", "event-correlation"],
      "eventChannels": ["System", "Application"],
      "escalationOptions": ["wpa-exporter-tables"],
      "traceSizeBudget": { "budgetMiB": 3072, "mode": "memory", "basis": "Toolkit guard: free-space preflight plus a post-stop ETL size check for a verbose CPU plus GeneralProfile recording.", "overBudgetAction": "stop-and-keep-partial-trace-with-explicit-truncation-record" },
      "privacyLevel": "Standard",
      "remediation": { "automaticRemediation": false, "operatorConfirmationRequired": true }
    },
    "memory-pressure": {
      "displayName": "Memory and commit pressure",
      "symptomSummary": "The machine swaps or stalls as memory fills; commit charge, available memory or the pagefile is the suspected constraint.",
      "tier1Counters": ["memory.commitPercent", "memory.availableBytes", "memory.availableMB", "memory.pagesInputPerSec", "memory.pagesOutputPerSec", "memory.pageFaultsPerSec", "pagefile.usagePercent", "process.privateBytesPeak", "process.pageFileBytesPeak"],
      "tier1SampleIntervalSeconds": 1,
      "tier2": { "wprProfiles": ["GeneralProfile"], "wprDetail": "verbose", "wprMode": "memory" },
      "expectedDurationSeconds": 300,
      "analysisModules": ["counter-trends", "memory-taxonomy", "pagefile-analysis", "process-ranking", "coverage-report", "sustained-window", "event-correlation"],
      "eventChannels": ["System", "Application", "Microsoft-Windows-WER/Operational"],
      "escalationOptions": ["poolmon-tag-attribution", "procdump-mini-on-consent"],
      "traceSizeBudget": { "budgetMiB": 2048, "mode": "memory", "basis": "Toolkit guard: free-space preflight plus a post-stop ETL size check. The pagefile and commit series do not enlarge the trace; the pool evidence comes from counters.", "overBudgetAction": "stop-and-keep-partial-trace-with-explicit-truncation-record" },
      "privacyLevel": "Standard",
      "remediation": { "automaticRemediation": false, "operatorConfirmationRequired": true }
    },
    "memory-leak": {
      "displayName": "Suspected memory or pool leak",
      "symptomSummary": "Commit charge, private bytes or kernel pool grows across the window and does not recover.",
      "tier1Counters": ["memory.commitPercent", "memory.availableMB", "memory.pagesInputPerSec", "process.privateBytesPeak", "process.sumPrivateBytes", "process.pageFileBytesPeak", "process.workingSetGrowthPercent", "pool.growthPercent", "pagefile.usagePercent"],
      "tier1SampleIntervalSeconds": 1,
      "tier2": { "wprProfiles": ["GeneralProfile"], "wprDetail": "verbose", "wprMode": "memory" },
      "expectedDurationSeconds": 900,
      "analysisModules": ["counter-trends", "leak-growth-detection", "pool-growth", "process-ranking", "memory-taxonomy", "coverage-report", "evidence-index"],
      "eventChannels": ["System", "Application", "Microsoft-Windows-WER/Operational"],
      "escalationOptions": ["poolmon-tag-attribution", "procdump-mini-on-consent"],
      "traceSizeBudget": { "budgetMiB": 3072, "mode": "memory", "basis": "Toolkit guard for a long verbose recording. A growth trend needs an uninterrupted series, so the trace is checked against free space before start and truncated explicitly after stop, never silently.", "overBudgetAction": "stop-and-keep-partial-trace-with-explicit-truncation-record" },
      "privacyLevel": "Standard",
      "remediation": { "automaticRemediation": false, "operatorConfirmationRequired": true }
    },
    "storage-io": {
      "displayName": "Storage and disk I/O pressure",
      "symptomSummary": "Slow file operations, high disk queue depth or elevated read and write latency.",
      "tier1Counters": ["disk.queueLength", "disk.readLatencySeconds", "disk.writeLatencySeconds", "disk.transferLatencySeconds", "disk.percentFree", "memory.availableMB", "cpu.loadPercent"],
      "tier1SampleIntervalSeconds": 1,
      "tier2": { "wprProfiles": ["DiskIO"], "wprDetail": "verbose", "wprMode": "memory" },
      "expectedDurationSeconds": 300,
      "analysisModules": ["counter-trends", "disk-latency-percentiles", "sustained-window", "process-ranking", "coverage-report", "event-correlation", "wpa-exporter-diskio"],
      "eventChannels": ["System", "Application", "Microsoft-Windows-Kernel-PnP/Configuration"],
      "escalationOptions": ["minifilter-enumeration", "storage-reliability-counters", "wpa-exporter-tables"],
      "traceSizeBudget": { "budgetMiB": 4096, "mode": "memory", "basis": "Toolkit guard: DiskIO verbose produces the largest per-second file event volume of the resource profiles, so free space is preflighted against this ceiling before start.", "overBudgetAction": "stop-and-keep-partial-trace-with-explicit-truncation-record" },
      "privacyLevel": "Standard",
      "remediation": { "automaticRemediation": false, "operatorConfirmationRequired": true }
    },
    "network": {
      "displayName": "Network and connectivity slowness",
      "symptomSummary": "Slow transfers, drops or resets reported while the machine is otherwise healthy.",
      "tier1Counters": ["network.retransmitPerSec", "network.connectionFailures", "network.connectionsReset", "cpu.loadPercent", "cpu.dpcPercent", "cpu.interruptsPerSec", "disk.readLatencySeconds"],
      "tier1SampleIntervalSeconds": 1,
      "tier2": { "wprProfiles": ["NetworkProfile"], "wprDetail": "verbose", "wprMode": "memory" },
      "expectedDurationSeconds": 300,
      "analysisModules": ["counter-trends", "network-counters", "sustained-window", "coverage-report", "event-correlation", "wpa-exporter-network"],
      "eventChannels": ["System", "Application"],
      "escalationOptions": ["pktmon-packet-capture", "wpa-exporter-tables"],
      "traceSizeBudget": { "budgetMiB": 3072, "mode": "memory", "basis": "Toolkit guard: free-space preflight plus a post-stop ETL size check for a NetworkProfile recording.", "overBudgetAction": "stop-and-keep-partial-trace-with-explicit-truncation-record" },
      "privacyLevel": "Redacted",
      "remediation": { "automaticRemediation": false, "operatorConfirmationRequired": true }
    },
    "gpu": {
      "displayName": "GPU and composition pressure",
      "symptomSummary": "Rendering or desktop composition stalls, GPU reset events, or high GPU engine utilization.",
      "tier1Counters": ["gpu.engineUtilizationPercent", "gpu.processDedicatedUsageBytes", "cpu.loadPercent", "cpu.utilityPercent", "memory.availableMB", "disk.readLatencySeconds"],
      "tier1SampleIntervalSeconds": 1,
      "tier2": { "wprProfiles": ["GeneralProfile"], "wprDetail": "verbose", "wprMode": "memory" },
      "expectedDurationSeconds": 300,
      "analysisModules": ["counter-trends", "gpu-unavailable-aware", "process-ranking", "coverage-report", "event-correlation", "wpa-exporter-gpu"],
      "eventChannels": ["System", "Application", "Microsoft-Windows-DriverFrameworks-UserMode/Operational"],
      "escalationOptions": ["wpa-exporter-tables"],
      "traceSizeBudget": { "budgetMiB": 4096, "mode": "memory", "basis": "Toolkit guard: free-space preflight plus a post-stop ETL size check. A GPU-specific WPR profile is used only when wpr -profiles reports it; the general profile is the fallback recording.", "overBudgetAction": "stop-and-keep-partial-trace-with-explicit-truncation-record" },
      "privacyLevel": "Standard",
      "remediation": { "automaticRemediation": false, "operatorConfirmationRequired": true }
    },
    "ui-hang": {
      "displayName": "User-interface hang",
      "symptomSummary": "The desktop or an application stops responding for seconds at a time and then recovers.",
      "tier1Counters": ["responsiveness.hangEvents", "cpu.loadPercent", "cpu.queueLength", "cpu.contextSwitchesPerSec", "memory.commitPercent", "memory.pagesInputPerSec", "disk.readLatencySeconds", "disk.queueLength"],
      "tier1SampleIntervalSeconds": 1,
      "tier2": { "wprProfiles": ["GeneralProfile"], "wprDetail": "verbose", "wprMode": "memory" },
      "expectedDurationSeconds": 180,
      "analysisModules": ["ui-responsiveness", "counter-trends", "sustained-window", "process-ranking", "coverage-report", "event-correlation", "wpa-exporter-responsiveness"],
      "eventChannels": ["System", "Application", "Application Hang", "Application Error"],
      "escalationOptions": ["wait-chain-traversal", "procdump-mini-on-consent"],
      "traceSizeBudget": { "budgetMiB": 3072, "mode": "memory", "basis": "Toolkit guard: free-space preflight plus a post-stop ETL size check. Responsiveness needs scheduler and ReadyThread evidence, so the recording is verbose by design.", "overBudgetAction": "stop-and-keep-partial-trace-with-explicit-truncation-record" },
      "privacyLevel": "Standard",
      "remediation": { "automaticRemediation": false, "operatorConfirmationRequired": true }
    },
    "ui-stutter": {
      "displayName": "User-interface stutter and dropped frames",
      "symptomSummary": "Movement and animation are visibly uneven without a full hang; input feels laggy.",
      "tier1Counters": ["cpu.loadPercent", "cpu.utilityPercent", "cpu.dpcPercent", "cpu.interruptsPerSec", "cpu.contextSwitchesPerSec", "memory.availableMB", "memory.pagesInputPerSec", "disk.readLatencySeconds", "gpu.engineUtilizationPercent"],
      "tier1SampleIntervalSeconds": 1,
      "tier2": { "wprProfiles": ["GeneralProfile"], "wprDetail": "verbose", "wprMode": "memory" },
      "expectedDurationSeconds": 180,
      "analysisModules": ["ui-responsiveness", "counter-trends", "process-ranking", "coverage-report", "gpu-unavailable-aware", "wpa-exporter-responsiveness"],
      "eventChannels": ["System", "Application", "Application Hang"],
      "escalationOptions": ["wpa-exporter-tables"],
      "traceSizeBudget": { "budgetMiB": 3072, "mode": "memory", "basis": "Toolkit guard: free-space preflight plus a post-stop ETL size check. Stutter needs DPC, interrupt and scheduler detail, so light detail is not sufficient here.", "overBudgetAction": "stop-and-keep-partial-trace-with-explicit-truncation-record" },
      "privacyLevel": "Standard",
      "remediation": { "automaticRemediation": false, "operatorConfirmationRequired": true }
    },
