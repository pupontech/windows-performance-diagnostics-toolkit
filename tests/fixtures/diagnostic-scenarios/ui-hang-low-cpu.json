        }
      ],
      "eventRows": [
        {
          "TimestampUtc": "2026-09-10T17:00:20Z",
          "ApplicationHangEvents": 1,
          "ProcessName": "explorer",
          "Provider": "Application Hang"
        }
      ],
      "rules": [
        {
          "id": "ui-hang-events",
          "category": "ui-responsiveness",
          "title": "Application hang events",
          "summary": "One or more application hang events were recorded.",
          "metric": "ApplicationHangEvents",
          "comparator": "ge",
          "threshold": 1,
          "minimumSamples": 1,
          "minimumDurationSeconds": 1,
          "sourceArtifact": "incident-events.json",
          "severity": {
            "default": "medium",
            "escalations": [
              {
                "severity": "high",
                "when": "the same process produces a hang and a crash in the same window"
              }
            ]
          },
          "confidence": {
            "default": "Medium",
            "conditions": [
              {
                "level": "High",
                "when": "a hang event and a wait chain result or a sustained CPU, disk or paging condition overlap in the same window"
              },
              {
                "level": "Low",
                "when": "only the hang event is present and no second channel overlaps it"
              }
            ]
          },
          "uncertainty": "A hang event states that the UI stopped responding, not why.",
          "nextSteps": [
            "Collect a wait-chain sample while the process is hung."
          ],
          "suggestedWprProfile": "CPU"
        },
        {
          "id": "cpu-pressure-sustained",
          "category": "cpu-pressure",
          "title": "Sustained CPU pressure",
          "summary": "The measured CPU series stayed at or above the configured threshold.",
          "metric": "AverageCpuLoadPercent",
          "comparator": "ge",
          "threshold": 80,
          "minimumSamples": 5,
          "minimumDurationSeconds": 5,
          "sourceArtifact": "performance-samples.csv",
          "severity": {
            "default": "medium",
            "escalations": [
              {
                "severity": "high",
                "when": "the qualifying run is at or above 95 percent and the sampling window contains at least 30 consecutive samples"
              }
            ]
          },
          "confidence": {
            "default": "Medium",
            "conditions": [
              {
                "level": "High",
                "when": "the run is at least 10 consecutive samples, no sample in the run is null, and the independent per-process CPU series names a top consumer inside the same window"
              },
              {
                "level": "Low",
                "when": "fewer than 5 finite CPU readings exist in the window, or the CPU source is the averaged fallback view rather than the utility counter"
              }
            ]
          },
          "uncertainty": "A counter threshold is not causation.",
          "nextSteps": [
            "Collect a CPU trace over the cited window."
          ],
          "suggestedWprProfile": "CPU"
        }
      ],
      "artifacts": [
        {
          "Name": "incident-events.json",
          "SizeBytes": 1234,
          "Sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        {
          "Name": "performance-samples.csv",
          "SizeBytes": 1234,
          "Sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    }
  },
  "note": "Synthetic fixture input only; no Windows provider is queried."
