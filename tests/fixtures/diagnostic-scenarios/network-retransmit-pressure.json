      "rules": [
        {
          "id": "network-retransmission-pressure",
          "category": "network-errors",
          "title": "TCP retransmissions",
          "summary": "Segments were retransmitted during the measured window.",
          "metric": "SegmentsRetransmittedPerSec",
          "comparator": "gt",
          "threshold": 0,
          "minimumSamples": 10,
          "minimumDurationSeconds": 10,
          "sourceArtifact": "network-state.json",
          "severity": {
            "default": "medium",
            "escalations": []
          },
          "confidence": {
            "default": "Low",
            "conditions": [
              {
                "level": "Medium",
                "when": "retransmissions and a failure or reset counter both move on the same interval"
              },
              {
                "level": "Low",
                "when": "retransmissions are non-zero without any failure or reset evidence"
              }
            ]
          },
          "correlationRequirements": [
            {
              "metric": "ConnectionFailures",
              "comparator": "gt",
              "threshold": 0,
              "kind": "required-any-of",
              "note": "Independent channel: connection failures on the same interval"
            },
            {
              "metric": "ConnectionsReset",
              "comparator": "gt",
              "threshold": 0,
              "kind": "required-any-of",
              "note": "Independent channel: connection resets on the same interval"
            }
          ],
          "uncertainty": "Retransmissions can be caused by the peer or the path.",
          "nextSteps": [
            "Capture a network trace over the same window."
          ],
          "suggestedWprProfile": "NetworkProfile"
        }
      ],
      "artifacts": [
        {
