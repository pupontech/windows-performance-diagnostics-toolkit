{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Windows Performance Diagnostics Toolkit Report",
  "description": "Schema for diagnostic-plan.json (Plan mode) and diagnostic-manifest.json (Collect mode) emitted by the Windows Performance Diagnostics Toolkit.",
  "type": "object",
  "required": ["schemaVersion", "toolName", "toolVersion", "mode", "safety"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0", "1.1"]
    },
    "toolName": {
      "type": "string",
      "enum": ["Windows Performance Diagnostics Toolkit"]
    },
    "toolVersion": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": ["Plan", "Collect"]
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "outputDirectory": {
      "type": "string"
    },
    "safety": {
      "type": "object",
      "required": [
        "localOnly",
        "readOnly",
        "requiresExplicitCollectionConsent",
        "automaticUpload",
        "automaticRemediation",
        "automaticLogClearing"
      ],
      "properties": {
        "localOnly": {
          "type": "boolean"
        },
        "readOnly": {
          "type": "boolean"
        },
        "requiresExplicitCollectionConsent": {
          "type": "boolean"
        },
        "automaticUpload": {
          "type": "boolean"
        },
        "automaticRemediation": {
          "type": "boolean"
        },
        "automaticLogClearing": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "plannedActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wpr": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["GeneralProfile", "CPU", "DiskIO", "FileIO", "Network", "Power", "GPU", "Registry"]
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "etlFilePath": {
          "type": ["string", "null"]
        },
        "startedAtUtc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "completedAtUtc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "startExitCode": {
          "type": ["integer", "null"]
        },
        "stopExitCode": {
          "type": ["integer", "null"]
        },
        "status": {
          "type": "string",
          "enum": ["completed", "skipped-wpr-not-found", "skipped-elevation-required", "failed"]
        }
      },
      "additionalProperties": false
    },
    "defender": {
      "type": "object",
      "properties": {
        "durationSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "etlFilePath": {
          "type": ["string", "null"]
        },
        "startedAtUtc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "completedAtUtc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "moduleVersion": {
          "type": ["string", "null"]
        },
        "status": {
          "type": "string",
          "enum": ["completed", "skipped-defender-module-not-found", "skipped-elevation-required", "failed"]
        }
      },
      "additionalProperties": false
    },
    "minidumps": {
      "type": "object",
      "description": "Present when -CollectMinidumps was requested. Plan mode advertises the scope; Collect mode reports the outcome. Source dumps are copied read-only; MEMORY.DMP is metadata only.",
      "properties": {
        "sourcePath": {
          "type": "string"
        },
        "maxTotalBytes": {
          "type": "integer"
        },
        "memoryDumpRecordedNotCopied": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "failed", "skipped-no-minidumps"]
        },
        "memoryDump": {
          "type": "object",
          "properties": {
            "exists": {
              "type": "boolean"
            },
            "sizeBytes": {
              "type": ["integer", "null"]
            },
            "lastWriteTimeUtc": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "copiedCount": {
          "type": "integer"
        },
        "skippedCount": {
          "type": "integer"
        },
        "totalBytes": {
          "type": "integer"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Name": {
                "type": "string"
              },
              "SizeBytes": {
                "type": "integer"
              },
              "SourceLastWriteTimeUtc": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "bootFailureLogs": {
      "type": "object",
      "description": "Present when -CollectBootFailureLogs was requested. Plan mode advertises the scope; Collect mode reports per-source outcome. Oversized logs are recorded with skippedReason 'oversized', never truncated.",
      "properties": {
        "maxBytesPerFile": {
          "type": "integer"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "failed"]
        },
        "copiedCount": {
          "type": "integer"
        },
        "skippedOversizedCount": {
          "type": "integer"
        },
        "sourceEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "sourcePath": {
                "type": "string"
              },
              "found": {
                "type": "boolean"
              },
              "sizeBytes": {
                "type": ["integer", "null"]
              },
              "copied": {
                "type": "boolean"
              },
              "copiedTo": {
                "type": ["string", "null"]
              },
              "skippedReason": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "startedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "completedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "properties": {
        "durationSeconds": {
          "type": "integer"
        },
        "maxSystemEvents": {
          "type": "integer"
        },
        "systemEventLookbackHours": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "system": {
      "type": "object",
      "additionalProperties": true
    },
    "systemEventLog": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": ["boolean", "null"]
        },
        "recordCount": {
          "type": ["integer", "null"]
        },
        "pulledCount": {
          "type": ["integer", "null"]
        },
        "skippedUnrenderableCount": {
          "type": ["integer", "null"]
        }
      },
      "additionalProperties": false
    },
    "crashAnalysis": {
      "type": "object",
      "properties": {
        "bugchecks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "TimeCreated": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "BugcheckCode": {
                "type": ["string", "null"]
              },
              "Message": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          }
        },
        "unexplainedShutdowns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "TimeCreated": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "Message": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "description": "In Plan mode: the planned read-only network-state sub-collections. In Collect mode: the DNS-vs-ping split-test summary and security-software match counts from the captured network-state.json.",
      "properties": {
        "subCollections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": ["completed", "failed"]
        },
        "artifact": {
          "type": "string"
        },
        "dnsVsPing": {
          "type": "object",
          "properties": {
            "rawIpReachable": {
              "type": ["boolean", "null"]
            },
            "dnsResolutionOk": {
              "type": ["boolean", "null"]
            },
            "verdict": {
              "type": "string",
              "enum": [
                "dns-and-connectivity-ok",
                "dns-failure",
                "icmp-blocked-or-partial",
                "connectivity-failure",
                "inconclusive"
              ]
            }
          },
          "additionalProperties": false
        },
        "securitySoftwareMatches": {
          "type": "object",
          "properties": {
            "processMatches": {
              "type": "integer"
            },
            "installedSoftwareMatches": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "sectionErrorCount": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "collectionErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Stage", "Message"],
        "properties": {
          "Stage": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Name", "SizeBytes", "Sha256"],
        "properties": {
          "Name": {
            "type": "string"
          },
          "SizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "Sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
